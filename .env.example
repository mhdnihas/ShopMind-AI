# Copy to .env and adjust. .env is git-ignored — never commit a real key.

# --- LLM ---------------------------------------------------------------
# "fake" = scripted model, no API key, fully offline (default).
# "google" = real Gemini model; requires GOOGLE_API_KEY.
LLM_PROVIDER=fake
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# --- Service URLs ------------------------------------------------------
STORE_API_URL=http://localhost:8002
ORDERS_AGENT_URL=http://localhost:8001
HTTP_TIMEOUT_SECONDS=10

# --- Persistence (R7) --------------------------------------------------
DATABASE_URL=postgresql://shopmind:shopmind@localhost:5432/shopmind

# --- Misc --------------------------------------------------------------
LOG_LEVEL=INFO
